{
  "expo": {
    "name": "Zbarber",
    "slug": "mobile",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "net.zbarber.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "package": "net.zbarber.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-build-properties",
      {
        "android": {
          "enableMinifyInReleaseBuilds": true,
          "enableShrinkResourcesInReleaseBuilds": true,
          "packagingOptions": {
            "exclude": [
              "META-INF/versions/9/OSGI-INF/MANIFEST.MF"
            ]
          }
        },
        "ios": {
          "extraPods": [
            { "name": "GoogleUtilities", "modular_headers": true },
            { "name": "RecaptchaInterop", "modular_headers": true },
            { "name": "AppAuth", "modular_headers": true },
            { "name": "GTMSessionFetcher", "modular_headers": true },
            { "name": "PromisesObjC", "modular_headers": true }
          ]
        }
      }],
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Zbarber utilise vos photos pour vous permettre de choisir une photo de profil ou de publier une photo d'un salon ou d'un service.",
          "cameraPermission": "Zbarber utilise l'appareil photo pour vous permettre de prendre une photo de profil ou d'ajouter directement une photo de salon ou de service.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Zbarber utilise votre position pour calculer les frais de déplacement du service à domicile."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0C1118",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0C1118"
          }
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/59c0644f-780e-40f1-8331-6a0afec307ad",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "59c0644f-780e-40f1-8331-6a0afec307ad"
      }
    },
    "owner": "tksm"
  }
}
