{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Zbarber Noir & Champagne. Direction supplied by the user: deep black, anthracite, champagne gold, ivory and restrained gray. Dark mode is authoritative; light mode is derived. Tokens are the single source of truth. No production data is included.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F5F3EF" },
      "foreground": { "$value": "#17191E" },
      "border": { "$value": "#DEDAD3" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#17191E" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#17191E" },
      "primary": {
        "$value": "#C9A76A",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#0C0D10" },
      "secondary": { "$value": "#ECE9E3" },
      "secondaryForeground": { "$value": "#17191E" },
      "muted": { "$value": "#ECE9E3" },
      "mutedForeground": { "$value": "#676A72" },
      "accent": { "$value": "#EEE3D0" },
      "accentForeground": { "$value": "#63491E" },
      "destructive": { "$value": "#B83D3D" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#DEDAD3" },
      "ring": { "$value": "#816130" },
      "chart1": { "$value": "#816130" },
      "chart2": { "$value": "#4C7668" },
      "chart3": { "$value": "#58728B" },
      "chart4": { "$value": "#9B6459" },
      "chart5": { "$value": "#75628A" },
      "sidebar": { "$value": "#FFFFFF" },
      "sidebarForeground": { "$value": "#17191E" },
      "sidebarBorder": { "$value": "#DEDAD3" },
      "sidebarPrimary": { "$value": "#C9A76A" },
      "sidebarPrimaryForeground": { "$value": "#0C0D10" },
      "sidebarAccent": { "$value": "#EEE3D0" },
      "sidebarAccentForeground": { "$value": "#63491E" },
      "sidebarRing": { "$value": "#816130" }
    },
    "dark": {
      "background": { "$value": "#0C0D10" },
      "foreground": { "$value": "#F5F3EF" },
      "border": { "$value": "#2B2D33" },
      "card": { "$value": "#17191E" },
      "cardForeground": { "$value": "#F5F3EF" },
      "popover": { "$value": "#17191E" },
      "popoverForeground": { "$value": "#F5F3EF" },
      "primary": { "$value": "#C9A76A" },
      "primaryForeground": { "$value": "#0C0D10" },
      "secondary": { "$value": "#22242A" },
      "secondaryForeground": { "$value": "#F5F3EF" },
      "muted": { "$value": "#22242A" },
      "mutedForeground": { "$value": "#92959D" },
      "accent": { "$value": "#30291E" },
      "accentForeground": { "$value": "#C9A76A" },
      "destructive": { "$value": "#F08080" },
      "destructiveForeground": { "$value": "#0C0D10" },
      "input": { "$value": "#2B2D33" },
      "ring": { "$value": "#C9A76A" },
      "chart1": { "$value": "#C9A76A" },
      "chart2": { "$value": "#83B6A1" },
      "chart3": { "$value": "#8DA9C8" },
      "chart4": { "$value": "#D59A89" },
      "chart5": { "$value": "#B09AC2" },
      "sidebar": { "$value": "#17191E" },
      "sidebarForeground": { "$value": "#F5F3EF" },
      "sidebarBorder": { "$value": "#2B2D33" },
      "sidebarPrimary": { "$value": "#C9A76A" },
      "sidebarPrimaryForeground": { "$value": "#0C0D10" },
      "sidebarAccent": { "$value": "#30291E" },
      "sidebarAccentForeground": { "$value": "#C9A76A" },
      "sidebarRing": { "$value": "#C9A76A" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Playfair Display", "Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
